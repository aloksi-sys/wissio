# WISSIO - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# Flask
FLASK_ENV=development
SECRET_KEY=gere-uma-chave-secreta-forte-aqui

# Banco de Dados (SQLite para desenvolvimento, PostgreSQL para produção)
# SQLite: DATABASE_URL=sqlite:///wissio.db
# PostgreSQL (Supabase): DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///wissio.db

# Para produção no Render, configure:
# FLASK_ENV=production
# SECRET_KEY=chave-super-secreta-gerada-com-secrets.token_hex(32)
# DATABASE_URL=postgresql://...